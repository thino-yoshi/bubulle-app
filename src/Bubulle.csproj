<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\bubulle.ico</ApplicationIcon>
    <AssemblyName>Bubulle</AssemblyName>
    <RootNamespace>Bulles</RootNamespace>
    <Version>0.2.6</Version>
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Son de déploiement par défaut, copié à côté de l'app (dossier sounds). -->
    <None Include="Assets\bubulle.ico" Link="bubulle.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\notification.gif" Link="notification.gif" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\sounds\open.m4a" Link="sounds\open.m4a" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
